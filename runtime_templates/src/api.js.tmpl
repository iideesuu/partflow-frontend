export async function apiRequest(path,{method='GET',body,rowVersion,idempotencyKey,...options}={}){const headers={Accept:'application/json',...(body!==undefined?{'Content-Type':'application/json'}:{}),...(options.headers||{})};const csrf=document.cookie.match(/(?:^|; )csrftoken=([^;]+)/)?.[1];if(csrf&&!['GET','HEAD','OPTIONS'].includes(method))headers['X-CSRFToken']=decodeURIComponent(csrf);if(rowVersion!==undefined&&rowVersion!==null)headers['If-Match']=String(rowVersion);if(idempotencyKey)headers['Idempotency-Key']=idempotencyKey;const raw=path.startsWith('/')?path:`/${path}`;const [p,q]=raw.split('?');const url=`${base}${p.endsWith('/')?p:`${p}/`}${q?`?${q}`:''}`;const response=await fetch(url,{...options,method,headers,credentials:'include',body:body===undefined?undefined:JSON.stringify(body)});const requestId=response.headers.get('X-Request-Id')||response.headers.get('X-Correlation-Id');if(!response.ok){const e=await response.json().catch(()=>({}));const detail=e.detail||e.message||(typeof e==='string'?e:'');const error=new Error(detail||`API request failed (${response.status})`);Object.assign(error,{status:response.status,details:e,requestId,code:e.code||e.error_code});throw error}if(response.status===204)return null;const text=await response.text();return text?JSON.parse(text):null}

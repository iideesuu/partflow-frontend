/* Apple-inspired readable typography */
:root {
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "SF Pro Text", "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 16px;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}
body { font-size: 1rem; }
.brand b { font-size: 18px; }
.brand span { font-size: 10px; }
.tenant { font-size: 13px; }
nav button { font-size: 14px; }
.nav-label { font-size: 11px; }
.env { font-size: 12px; }
.user b { font-size: 13px; }
.user span { font-size: 12px; }
.breadcrumbs { font-size: 13px; }
.api-status { font-size: 12px; }
.page-head h1 { font-size: 30px; letter-spacing: -0.5px; }
.page-head p { font-size: 15px; }
.eyebrow { font-size: 11px; }
.btn { font-size: 14px; padding: 11px 16px; }
.btn.tiny { font-size: 12px; }
.link { font-size: 13px; }
.stat-label { font-size: 13px; }
.stat-value { font-size: 28px; }
.stat-hint { font-size: 11px; }
.card-head h2, .section-title h2 { font-size: 17px; }
.muted { font-size: 13px; }
table { font-size: 13px; }
th { font-size: 12px; }
.badge { font-size: 11px; }
.todo b { font-size: 13px; }
.todo span { font-size: 12px; }
.activity-row span { font-size: 12px; }
.activity-row small { font-size: 11px; }
.search input, .toolbar select, .field select { font-size: 14px; }
.field { font-size: 13px; }
.field input, .field textarea { font-size: 14px; padding: 10px 11px; }
.field small, .field-note { font-size: 12px; }
.row-action, .lifecycle { font-size: 12px; }
.structure-meta, .tree-row { font-size: 13px; }
.bom-item b { font-size: 13px; }
.bom-item span:not(.badge) { font-size: 12px; }
.position, .bom-code { font-size: 11px; }
.notice, .gate { font-size: 13px; }
.file-name b { font-size: 13px; }
.file-name span, .scan { font-size: 12px; }
.tabs button { font-size: 14px; }
.audit-content>b { font-size: 13px; }
.audit-content>strong { font-size: 12px; }
.audit-content small { font-size: 11px; }
.setting-card h2 { font-size: 16px; }
.setting-card p { font-size: 13px; }
.setting-row { font-size: 12px; }
.login-card h1 { font-size: 28px; }
